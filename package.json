{
  "name": "yumezu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "夢図（Yumezu）— 基于はるまきごはん世界观的 1v1 回合制网页同人游戏",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yml,yaml,css,html}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "vitest run test/demo.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "delaunator": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
